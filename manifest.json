{
  "name": "logic-groove-mcp",
  "display_name": "Logic Groove MCP",
  "description": "Bidirectional, stateful control of Logic Pro from AI assistants. 9 dispatcher tools + 7 resources across 5 native macOS channels.",
  "version": "0.2.0",
  "author": "Golden Lobster Studio (Sorin Gheorghita); based on work by Kolton Jacobs",
  "license": "MIT",
  "homepage": "https://github.com/goldenlobster2019-bit/logic-groove-mcp",
  "repository": "https://github.com/goldenlobster2019-bit/logic-groove-mcp",
  "platforms": ["macos"],
  "runtime": "native",
  "installation": {
    "macos": {
      "command": "LogicGrooveMCP",
      "args": [],
      "download_url": "https://github.com/goldenlobster2019-bit/logic-groove-mcp/releases/latest/download/LogicGrooveMCP",
      "install_path": "/usr/local/bin/LogicGrooveMCP"
    }
  },
  "permissions": [
    "accessibility",
    "automation"
  ],
  "tools": [
    "logic_transport",
    "logic_tracks",
    "logic_mixer",
    "logic_midi",
    "logic_edit",
    "logic_navigate",
    "logic_compose",
    "logic_project",
    "logic_system"
  ],
  "resources": [
    "logic://transport/state",
    "logic://tracks",
    "logic://tracks/{index}",
    "logic://mixer",
    "logic://project/info",
    "logic://midi/ports",
    "logic://system/health"
  ]
}
